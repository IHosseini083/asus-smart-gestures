# Maintainer: Iliya
pkgname=asus-smart-gestures-git
pkgver=0.2.0
pkgrel=1
pkgdesc="ASUS touchpad edge-slide gesture daemon for Linux (volume, brightness, media)"
arch=('any')
url="https://github.com/IHosseini083/asus-smart-gestures"
license=('MIT')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
provides=('asus-smart-gestures')
conflicts=('asus-smart-gestures')
source=()

package() {
    cd "$startdir/.."
    python -m build --wheel --no-isolation
    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 systemd/asus-smart-gestures.service "$pkgdir/usr/lib/systemd/system/asus-smart-gestures.service"
    install -Dm644 systemd/uinput.conf "$pkgdir/usr/lib/modules-load.d/asus-smart-gestures.conf"
    install -Dm644 config/asus-smart-gestures.conf.example "$pkgdir/etc/asus-smart-gestures.conf"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
